# Copy this file to .env and edit as needed. .env is gitignored.

# ---------------------------------------------------------------------------
# oMLX (scripts/setup.sh configures these into ~/.omlx/settings.json as well)
# ---------------------------------------------------------------------------
# Strong API key required when binding non-loopback. Generated by `make setup`
# if missing. Never commit the real value.
# OMLX_API_KEY=

# OMLX_HOST=0.0.0.0
# OMLX_PORT=8000
# OMLX_MODEL_DIR=~/.omlx/models
# OMLX_MAX_CONCURRENT=8
# OMLX_MEMORY_GUARD=balanced   # safe is tighter; balanced needed for brain+worker residency
# OMLX_SSD_CACHE_DIR=~/.omlx/ssd-cache
# OMLX_SSD_CACHE_MAX_SIZE=100GB

# Base URL this machine's scripts use to talk to oMLX locally.
# UPSTREAM_URL=http://localhost:8000
# OMLX_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# LiteLLM sync (scripts/sync-litellm.py / `make sync-litellm`)
# ---------------------------------------------------------------------------
# Admin key for the LiteLLM proxy. Never committed.
# Prefer LITELLM_ADMIN_KEY (also accepts LITELLM_API_KEY / LITELLM_MASTER_KEY).
# LITELLM_ADMIN_KEY=sk-...
# LITELLM_URL=http://localhost:4000

# api_base baked into each LiteLLM model. MUST be reachable FROM the LiteLLM
# host — use this Mac's LAN IP, .local name, or Tailscale name, NOT localhost.
# MODEL_API_BASE=http://bingc-studio5.local:8000/v1

# api_key stored per model (oMLX requires a key on non-loopback binds).
# Defaults to OMLX_API_KEY when unset.
# MODEL_API_KEY=

# Stable owner tag written to model_info.managed_by. Not a hostname.
# LITELLM_OWNER=macos-omlx
# Optional informational host label:
# MODEL_MANAGED_HOST=bingc-studio5

# Per-model LiteLLM reliability (local generations must not be re-fired).
# MODEL_NUM_RETRIES=0
# MODEL_TIMEOUT=900
# MODEL_PROVIDER=openai
